# ============================================================================
# NRO Shield — Environment Configuration
# ============================================================================
# Copy file này thành .env và sửa các giá trị phù hợp:
#   cp .env.example .env
#   nano .env
# ============================================================================

# === VPS CONFIG ===
VPS_PUBLIC_IP=""                    # IP public VPS firewall (BẮT BUỘC)
SSH_PORT=2222                       # Port SSH (nên đổi khỏi 22)

# === DATABASE ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nroshield
DB_PASS=your_strong_password_here
DB_NAME=nroshield

# === JWT ===
JWT_SECRET=your_jwt_secret_change_this_to_random_string
JWT_EXPIRES_IN=7d

# === PROXY PORT RANGE ===
PROXY_PORT_RANGE_START=30000        # Port bắt đầu cho proxy
PROXY_PORT_RANGE_END=60000          # Port kết thúc cho proxy

# === FIREWALL DEFAULTS ===
MAX_CONN_PER_IP=500                 # Connection tối đa per IP
SYN_RATE_LIMIT=200/sec              # SYN rate limit per IP
UDP_RATE_LIMIT=1000/sec              # UDP rate limit per IP
NEW_CONN_RATE=200/sec               # New connection rate per IP

# === MONITORING THRESHOLDS ===
CONN_ALERT_THRESHOLD=500            # Cảnh báo khi tổng connection vượt
PPS_ALERT_THRESHOLD=10000           # Cảnh báo packets/sec

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=                 # Token từ @BotFather
TELEGRAM_CHAT_ID=                   # Chat ID admin

# === SERVICES PORTS ===
API_PORT=5000                       # Backend API port
AI_ENGINE_PORT=8000                 # AI Engine FastAPI port

# === AI ENGINE ===
AI_LEARNING_DAYS=7                  # Số ngày learn-only trước khi detect
AI_RETRAIN_INTERVAL=3600            # Chu kỳ retrain model (giây)
AI_COLLECT_INTERVAL=5               # Chu kỳ thu thập metrics (giây)
AI_BLOCK_THRESHOLD=0.8              # Ngưỡng anomaly để auto-block
AI_RATE_LIMIT_THRESHOLD=0.6         # Ngưỡng anomaly để rate limit
